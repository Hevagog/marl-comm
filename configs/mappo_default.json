{
  "experiment": {
    "name": "mappo_coingame",
    "agent_type": "mappo",
    "directory": "runs",
    "wandb": true,
    "wandb_kwargs": {
      "project": "marl-comm",
      "tags": ["mappo", "coingame"]
    },
    "write_interval": "auto",
    "checkpoint_interval": "auto",
    "store_separately": false
  },

  "env": {
    "id": "coingame",
    "grid_size": 7,
    "max_cycles": 50,
    "pick_reward": 1.0,
    "steal_penalty": -2.0
  },

  "training": {
    "timesteps": 500000,
    "seed": 42
  },

  "eval": {
    "timesteps": 5000,
    "checkpoint_path": null
  },

  "record": {
    "timesteps": 1000,
    "checkpoint_path": null,
    "video_dir": "recordings",
    "fps": 4
  },

  "mappo": {
    "rollouts": 16,
    "learning_epochs": 8,
    "mini_batches": 2,

    "discount_factor": 0.99,
    "lambda": 0.95,

    "learning_rate": 3e-4,
    "learning_rate_scheduler": null,
    "learning_rate_scheduler_kwargs": {},

    "state_preprocessor": null,
    "state_preprocessor_kwargs": {},
    "shared_state_preprocessor": null,
    "shared_state_preprocessor_kwargs": {},
    "value_preprocessor": null,
    "value_preprocessor_kwargs": {},

    "random_timesteps": 0,
    "learning_starts": 0,

    "grad_norm_clip": 0.5,
    "ratio_clip": 0.2,
    "value_clip": 0.2,
    "clip_predicted_values": false,

    "entropy_loss_scale": 0.01,
    "value_loss_scale": 0.5,

    "kl_threshold": 0,

    "rewards_shaper": null,
    "time_limit_bootstrap": false
  },

  "policy": {
    "hidden_sizes": [64, 64],
    "unnormalized_log_prob": true
  },

  "value": {
    "hidden_sizes": [64, 64]
  },

  "memory": {
    "size": 16
  }
}
